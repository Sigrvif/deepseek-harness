  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/prompt/delivery-style"
  },
  "type": "module",
  "main": "lib/index.js",
